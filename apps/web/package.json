{
  "name": "@nostakes/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --strict --type-check",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "tsrs --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "vite build",
    "brand": "node scripts/brand.ts",
    "check": "pnpm run typecheck",
    "verify": "vitest run --config vitest.verify.config.ts --silent=false && node scripts/two-players.ts && PHONE_ENGINES=chromium node scripts/phones.ts && FACE_ENGINES=chromium node scripts/face.ts && node scripts/landing.ts && node scripts/learn.ts && KEEP_ENGINES=chromium node scripts/keep-pictures.ts && CLIP_ENGINES=chromium node scripts/keep-clips.ts",
    "phones": "node scripts/phones.ts",
    "face": "FACE_SWIPES=touch node scripts/face.ts",
    "landing": "LANDING_ENGINES=chromium,webkit node scripts/landing.ts",
    "learn": "LEARN_ENGINES=chromium,webkit node scripts/learn.ts",
    "shots": "node scripts/phone-shots.ts",
    "membership-shots": "node scripts/membership-shots.ts",
    "rules-shots": "node scripts/rules-shots.ts",
    "moments": "node scripts/moment-pictures.ts",
    "keep": "node scripts/keep-pictures.ts",
    "clips": "node scripts/keep-clips.ts",
    "reels": "node scripts/clip-reels.ts",
    "night": "node scripts/night-pictures.ts"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.2",
    "@mediabunny/aac-encoder": "1.65.2",
    "@nostakes/avatar": "workspace:*",
    "@nostakes/client": "workspace:*",
    "@nostakes/engine": "workspace:*",
    "@nostakes/protocol": "workspace:*",
    "@nostakes/room": "workspace:*",
    "@nostakes/shuffle": "workspace:*",
    "effect": "4.1.2",
    "foldkit": "0.170.0",
    "mediabunny": "1.65.2"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.2",
    "@effect/vitest": "4.1.2",
    "@foldkit/vite-plugin": "0.29.0",
    "@types/node": "24.19.2",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
