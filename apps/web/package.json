{
  "name": "@nostakes/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --strict --type-check",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "tsrs --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "vite build",
    "brand": "node scripts/brand.ts",
    "check": "pnpm run typecheck",
    "verify": "node scripts/two-players.ts && PHONE_ENGINES=chromium node scripts/phones.ts",
    "phones": "node scripts/phones.ts",
    "shots": "node scripts/phone-shots.ts"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.2",
    "@nostakes/avatar": "workspace:*",
    "@nostakes/client": "workspace:*",
    "@nostakes/engine": "workspace:*",
    "@nostakes/protocol": "workspace:*",
    "@nostakes/room": "workspace:*",
    "effect": "4.1.2",
    "foldkit": "0.170.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.2",
    "@effect/vitest": "4.1.2",
    "@foldkit/vite-plugin": "0.29.0",
    "@types/node": "24.19.2",
    "playwright-core": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
