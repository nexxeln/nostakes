    "check": "pnpm run typecheck"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.4",
    "@types/node": "24.19.2",
    "effect": "4.1.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
