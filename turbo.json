{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "typecheck:tsc": {
      "dependsOn": ["^typecheck:tsc"],
      "outputs": []
    },
    "//#typecheck:tsc-scripts": {
      "outputs": []
    },
    "typecheck:fast": {
      "dependsOn": ["^typecheck:fast"],
      "outputs": []
    },
    "//#typecheck:fast-scripts": {
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "verify": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": []
    },
    "//#lint": {
      "outputs": []
    },
    "//#typecheck-scripts": {
      "outputs": []
    },
    "//#lockfile:check": {
      "cache": false,
      "outputs": []
    },
    "check": {
      "dependsOn": [
        "//#lockfile:check",
        "typecheck",
        "//#lint",
        "//#typecheck-scripts"
      ],
      "outputs": []
    },
    "@nostakes/fence#typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/**"]
    },
    "@nostakes/fence#test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/oxlint.config.ts",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/tools/oxlint/**"
      ]
    },
    "@nostakes/room-server#test": {
      "dependsOn": ["build", "^build", "^test"],
      "outputs": []
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["ALLOWED_ORIGINS"]
    }
  }
}
